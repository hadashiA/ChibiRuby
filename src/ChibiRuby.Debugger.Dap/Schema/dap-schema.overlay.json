{
    "_comment_overlay_purpose": "ChibiRuby additions to the upstream DAP schema. Applied by build-schema.sh via jq deep-merge. Two kinds of additions:  (1) OpenAPI-style discriminator on `Request` so NoJsonSchema can polymorphically dispatch by `command` (drops a 17-arm manual switch in the handler);  (2) adapter-specific fields the upstream schema doesn't model (currently just `program` on launch/attach arguments).",

    "definitions": {

        "Request": {
            "_comment_discriminator": "Polymorphic dispatch on `command`. NoJsonSchema combines this with the existing allOf:[ProtocolMessage,{...}] inheritance — Request stays abstract, owns its command/arguments/seq/type, and dispatches into the concrete XxxRequest subtype on deserialize.",
            "discriminator": {
                "propertyName": "command",
                "mapping": {
                    "attach":            "#/definitions/AttachRequest",
                    "configurationDone": "#/definitions/ConfigurationDoneRequest",
                    "continue":          "#/definitions/ContinueRequest",
                    "disconnect":        "#/definitions/DisconnectRequest",
                    "evaluate":          "#/definitions/EvaluateRequest",
                    "initialize":        "#/definitions/InitializeRequest",
                    "launch":            "#/definitions/LaunchRequest",
                    "next":              "#/definitions/NextRequest",
                    "pause":             "#/definitions/PauseRequest",
                    "scopes":            "#/definitions/ScopesRequest",
                    "setBreakpoints":    "#/definitions/SetBreakpointsRequest",
                    "stackTrace":        "#/definitions/StackTraceRequest",
                    "stepIn":            "#/definitions/StepInRequest",
                    "stepOut":           "#/definitions/StepOutRequest",
                    "terminate":         "#/definitions/TerminateRequest",
                    "threads":           "#/definitions/ThreadsRequest",
                    "variables":         "#/definitions/VariablesRequest"
                }
            },
            "oneOf": [
                { "$ref": "#/definitions/AttachRequest" },
                { "$ref": "#/definitions/ConfigurationDoneRequest" },
                { "$ref": "#/definitions/ContinueRequest" },
                { "$ref": "#/definitions/DisconnectRequest" },
                { "$ref": "#/definitions/EvaluateRequest" },
                { "$ref": "#/definitions/InitializeRequest" },
                { "$ref": "#/definitions/LaunchRequest" },
                { "$ref": "#/definitions/NextRequest" },
                { "$ref": "#/definitions/PauseRequest" },
                { "$ref": "#/definitions/ScopesRequest" },
                { "$ref": "#/definitions/SetBreakpointsRequest" },
                { "$ref": "#/definitions/StackTraceRequest" },
                { "$ref": "#/definitions/StepInRequest" },
                { "$ref": "#/definitions/StepOutRequest" },
                { "$ref": "#/definitions/TerminateRequest" },
                { "$ref": "#/definitions/ThreadsRequest" },
                { "$ref": "#/definitions/VariablesRequest" }
            ]
        },

        "LaunchRequestArguments": {
            "_comment_program": "ChibiRuby adapter-specific: absolute path to the Ruby script to load. The standard DAP launch arguments are extension-points (`Additional attributes are implementation specific`), so it's legitimate to extend the schema here rather than tack it on at deserialize time.",
            "properties": {
                "program": {
                    "type": "string",
                    "description": "ChibiRuby adapter-specific: absolute path to the Ruby script to load and run on launch."
                }
            }
        },

        "AttachRequestArguments": {
            "properties": {
                "program": {
                    "type": "string",
                    "description": "ChibiRuby adapter-specific: absolute path to the Ruby script the host is running (used to resolve relative source paths in stack frames)."
                }
            }
        }

    }
}
