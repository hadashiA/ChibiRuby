<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.1</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>13</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>Optional IO / File / HTTP / JSON modules for ChibiRuby. Each module is activated explicitly (DefineIO / DefineHttp / DefineJson) so hosts opt into exactly the OS surface they want to expose to Ruby code.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ChibiRuby.NIO.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ChibiRuby\ChibiRuby.csproj" />
        <ProjectReference Include="..\ChibiRuby.SourceGenerator\ChibiRuby.SourceGenerator.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup>
        <ChibiRubyGenerator_RbsOutputDirectory>$(MSBuildProjectDirectory)/../../sig</ChibiRubyGenerator_RbsOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
        <CompilerVisibleProperty Include="ChibiRubyGenerator_RbsOutputDirectory" />
    </ItemGroup>

</Project>
