<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.1</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>13</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ChibiRuby.Tests" />
        <InternalsVisibleTo Include="ChibiRuby.Serializer" />
        <InternalsVisibleTo Include="SampleConsoleApp" />
        <InternalsVisibleTo Include="ChibiRuby.Debugger" />
        <InternalsVisibleTo Include="ChibiRuby.Debugger.Tests" />
        <InternalsVisibleTo Include="ChibiRuby.JetPack" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Utf8StringInterpolation" Version="1.3.2" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
<!--        <PackageReference Include="System.Buffers" Version="4.6.0" />-->
<!--        <PackageReference Include="System.Memory" Version="4.6.0" />-->
<!--        <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.0" />-->
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ChibiRuby.SourceGenerator\ChibiRuby.SourceGenerator.csproj">
          <OutputItemType>Analyzer</OutputItemType>
          <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      </ProjectReference>
    </ItemGroup>

    <PropertyGroup>
        <ChibiRubyGenerator_RbsOutputDirectory>$(MSBuildProjectDirectory)/../../sig</ChibiRubyGenerator_RbsOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
        <CompilerVisibleProperty Include="ChibiRubyGenerator_RbsOutputDirectory" />
    </ItemGroup>

    <ItemGroup>
        <None Include="StdLib\**\*.mrb">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="StdLib\lib.rbs" />
    </ItemGroup>

</Project>
