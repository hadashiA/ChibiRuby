{
  "name": "chibiruby-debugger",
  "displayName": "ChibiRuby Debugger",
  "description": "DAP debug adapter for ChibiRuby (mruby on .NET).",
  "version": "1.4.2",
  "publisher": "hadashiA",
  "repository": {
    "type": "git",
    "url": "https://github.com/hadashiA/ChibiRuby.git"
  },
  "homepage": "https://github.com/hadashiA/ChibiRuby#readme",
  "bugs": {
    "url": "https://github.com/hadashiA/ChibiRuby/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Debuggers"
  ],
  "keywords": [
    "mruby",
    "ruby",
    "debugger",
    "DAP",
    "chibiruby"
  ],
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onDebug",
    "onDebugResolve:chibiruby",
    "onDebugDynamicConfigurations:chibiruby",
    "onCommand:chibiruby.attachToRunningHost"
  ],
  "contributes": {
    "commands": [
      {
        "command": "chibiruby.attachToRunningHost",
        "title": "ChibiRuby: Attach to running host",
        "category": "ChibiRuby"
      }
    ],
    "breakpoints": [
      {
        "language": "ruby"
      }
    ],
    "debuggers": [
      {
        "type": "chibiruby",
        "label": "ChibiRuby",
        "languages": [
          "ruby"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .rb file to debug.",
                "default": "${file}"
              },
              "adapterCommand": {
                "type": "string",
                "description": "Path or name of the mruby-debug binary. Defaults to `mruby-debug` (resolved from PATH).",
                "default": "mruby-debug"
              },
              "adapterArgs": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Additional arguments passed to the adapter before the DAP handshake (e.g. `[\"--verbose\"]`).",
                "default": []
              }
            }
          },
          "attach": {
            "properties": {
              "host": {
                "type": "string",
                "description": "Host running the embedded MRubyDapTcpServer.",
                "default": "127.0.0.1"
              },
              "port": {
                "type": "number",
                "description": "TCP port the embedded MRubyDapTcpServer is listening on.",
                "default": 4711
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "ChibiRuby: Launch current file",
            "description": "Debug the active .rb file with ChibiRuby.",
            "body": {
              "type": "chibiruby",
              "request": "launch",
              "name": "ChibiRuby: Debug ${1:script.rb}",
              "program": "^\"\\${workspaceFolder}/${1:script.rb}\""
            }
          },
          {
            "label": "ChibiRuby: Attach to embedded host",
            "description": "Connect to a running C# host that exposes MRubyDapTcpServer on a TCP port.",
            "body": {
              "type": "chibiruby",
              "request": "attach",
              "name": "ChibiRuby: Attach (port 4711)",
              "host": "127.0.0.1",
              "port": 4711
            }
          }
        ],
        "initialConfigurations": [
          {
            "type": "chibiruby",
            "request": "attach",
            "name": "ChibiRuby: Attach to embedded host",
            "host": "127.0.0.1",
            "port": 4711
          }
        ]
      }
    ]
  }
}
