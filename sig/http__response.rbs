# HTTP::Response — one HTTP exchange's response. The body is already-buffered by the time this object exists; access it with #body (which gives you an HTTP::Body) or convert to a String via #body.to_s. <para> /// 4xx / 5xx responses are returned to Ruby without raising (matching /// <c>HttpClient</c>'s default). Use <c>#success?</c> / <c>#error?</c> / /// <c>#ensure_success_status!</c> to branch on the result. /// </para>
class HTTP::Response < Object
  # response.status — numeric HTTP status code (200, 404, …).
  def status: () -> Integer

  # response.headers — HTTP::Headers bag for this response. Identity is stable across calls.
  def headers: () -> HTTP::Headers

  # response.body — HTTP::Body wrapper. Call .to_s for the raw String.
  def body: () -> HTTP::Body

  # response.uri — the final request URI as a String (after redirect following, if any was performed by the client).
  def uri: () -> String

  # response.version — HTTP protocol version negotiated for this response (e.g. "1.1", "2").
  def version: () -> String

  # response.content_type — the parsed Content-Type header value (or nil). Convenience over response.headers["content-type"].
  def content_type: () -> String?

  # response.success? — true iff 200 ≤ status < 300.
  def success?: () -> bool

  # response.redirect? — true iff 300 ≤ status < 400. Note: by default the HTTP client transparently follows redirects, so you only see one of these if you set follow_redirects: false.
  def redirect?: () -> bool

  # response.client_error? — true iff 400 ≤ status < 500.
  def client_error?: () -> bool

  # response.server_error? — true iff 500 ≤ status < 600.
  def server_error?: () -> bool

  # response.error? — alias for client_error? || server_error?.
  def error?: () -> bool

  # response.ensure_success_status! — raise HTTP::Error if the status indicates failure (≥ 400); otherwise return self so the call chains. Modeled after EnsureSuccessStatusCode.
  def ensure_success_status!: () -> self

  # response.json — lazily parse the body as JSON. The result is cached on the response so repeated calls are O(1). Requires the optional JSON module to be enabled via MRubyState.DefineJson(); otherwise raises NotImplementedError. Body parse failures raise JSON::ParserError.
  def json: () -> untyped

  # response.inspect — debug summary (status, uri, byte length).
  def inspect: () -> String

  # response.to_s — alias for body.to_s. Mirrors the convenience HTTPX offers so puts HTTP.get(url) prints the body.
  def to_s: () -> String

end
