# A first-class callable created from a block. Capture a block as a Proc with Proc.new, proc { ... }, or the &block parameter form; invoke with call, [], or .(). Lambdas (->) are Procs with stricter arity and return semantics.
class Proc < Object
  # Returns the number of mandatory arguments. If the block takes a rest argument, returns -(required + 1).
  #
  #   proc { |a, b| }.arity      # => 2
  #   proc { |*a| }.arity        # => -1
  def arity: () -> Integer

  # Returns true if self and the given value refer to the same Proc.
  #
  #   pr = proc { |x| x }
  #   pr.eql?(pr)       # => true
  #   pr.eql?(proc {})  # => false
  def eql?: (untyped) -> bool
  alias == eql?

  # Creates a new Proc from the given block.
  #
  #   pr = Proc.new { |x| x + 1 }
  #   pr.call(5)        # => 6
  def self.new: () { (*untyped) -> untyped } -> Proc

end
