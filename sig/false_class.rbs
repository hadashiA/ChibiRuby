  #   false | nil        # => false
  def |: (untyped) -> bool

  # Returns true if the argument is truthy, otherwise false.
  #
  #   false ^ true       # => true
  #   false ^ false      # => false
  def ^: (untyped) -> bool

  # Returns the String "false".
  #
  #   false.to_s         # => "false"
  def to_s: () -> String
