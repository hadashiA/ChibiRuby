  def equal?: (untyped) -> bool
  alias == equal?

  # Returns an integer identifier for self. Equal to object_id.
  #
  #   obj = Object.new
  #   obj.__id__ == obj.__id__   # => true
  def __id__: () -> Integer

  # Invokes the method named name on self with the given arguments and block.
  #
  #   "hello".__send__(:upcase)        # => "HELLO"
  #   [1, 2, 3].__send__(:push, 4)     # => [1, 2, 3, 4]
