  # Evaluates the given block in the context of self, where self within the block refers to the receiver.
  #
  #   "hello".instance_eval { upcase }   # => "HELLO"
  def instance_eval: (*untyped) ?{ (instance) -> untyped } -> untyped

  # Invoked by Ruby when an undefined method is called. The default implementation raises NoMethodError.
  #
  #   class Foo
  #     def method_missing(name, *args)
  #       "called #{name}"
  #     end
  #   end
  #   Foo.new.bar    # => "called bar"
