# Interned, immutable identifier -- written :name. Two symbols with the same name are the same object, which makes them efficient as hash keys, method names, and tag values. Convert to and from strings with to_s and String#to_sym.
class Symbol < Object
  # Returns the string representation of self (without the leading colon).
  #
  #   :foo.to_s        # => "foo"
  def to_s: () -> String

  # Returns the name of self as a frozen String.
  #
  #   :foo.name        # => "foo"
  def name: () -> String

  # Returns a printable representation of self, prefixed with a colon.
  #
  #   :foo.inspect     # => ":foo"
  def inspect: () -> String

  # Compares self with another symbol. Returns -1, 0, or 1, or nil when the other value is not a Symbol.
  #
  #   :foo <=> :foo   # => 0
  #   :bar <=> :foo   # => -1
  def <=>: (untyped) -> Integer?

  # --- from lib.rb ---
  #
  # call-seq:
  #   sym.to_proc -> proc
  #
  # Returns a Proc that, when called with an object, invokes the method
  # named by +sym+ on that object with any additional arguments.
  #
  #   [1, 2, 3].map(&:to_s)   #=> ["1", "2", "3"]
  def to_proc: () -> untyped
end
