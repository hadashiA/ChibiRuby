# Cooperatively-scheduled coroutine. A Fiber runs a block until it calls Fiber.yield, at which point control returns to whoever called resume; the next resume continues from the yield point. In ChibiRuby, fibers also drive async/await interop via the active fiber scheduler.
class Fiber < Object
  # Initializes a new Fiber with the given block as its body.
  #
  #   f = Fiber.new { |x| Fiber.yield x + 1 }
  #   f.resume(10)        # => 11
  def initialize: () { (*untyped) -> untyped } -> void

  # Returns true if self and the given value are the same fiber.
  #
  #   f = Fiber.new {}
  #   f == f              # => true
  def ==: (untyped) -> bool

  # Returns a String describing self, including its current state.
  #
  #   f = Fiber.new {}
  #   f.to_s              # => "#<Fiber:(created)>"
  def to_s: () -> String
  alias inspect to_s

  # Resumes the fiber, passing any arguments to its block (or its previous Fiber.yield). Returns the value yielded or the block's final value.
  #
  #   f = Fiber.new { |x| Fiber.yield x * 2 }
  #   f.resume(3)         # => 6
  def resume: (*untyped) -> untyped

  # Transfers control to self, switching the running fiber explicitly. Unlike resume, the transferred-from fiber cannot be resumed implicitly; control must be transferred back.
  #
  #   f = Fiber.new { Fiber.yield 1 }
  #   f.transfer          # => 1
  def transfer: (*untyped) -> untyped

  # Returns true while the fiber has not yet terminated.
  #
  #   f = Fiber.new { }
  #   f.alive?            # => true
  #   f.resume
  #   f.alive?            # => false
  def alive?: () -> bool

  # Suspends the currently running fiber and returns the given values to the caller of resume.
  #
  #   f = Fiber.new { Fiber.yield 42 }
  #   f.resume            # => 42
  def self.yield: (*untyped) -> untyped

  # Returns the currently running fiber.
  #
  #   Fiber.current       # => Fiber
  def self.current: () -> Fiber

  # Fiber.schedule { ... } -- convenience for creating a fiber and starting it immediately under the installed scheduler. Returns the new RFiber; the caller can observe it via alive? or just rely on the scheduler to drive it to completion. CRuby's blocking: false distinction is implicit here: any fiber under a scheduler that hits sleep/Thread.pass/IO will dispatch through the scheduler.
  def self.schedule: () { (*untyped) -> untyped } -> Fiber

end
